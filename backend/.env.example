# ThermaShift AI — Environment Variables Example
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thermashift
FORTYGUARD_API_KEY=your_fortyguard_api_key_here
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
DEFAULT_POLL_INTERVAL_MINUTES=10
ALERT_COOLDOWN_MINUTES=30
CALLE_API_KEY=your_calle_api_key_here
CALLE_BASE_URL=https://api.heycall-e.com/v1
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here
